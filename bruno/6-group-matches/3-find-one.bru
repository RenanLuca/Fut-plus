meta {
  name: Find one match
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/groups/{{groupId}}/group-matches/{{matchId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

tests {
  test("deve retornar só a partida (sem presenças/times misturados)", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("matchId"));
    expect(res.getBody()).to.have.property('matchDate');
    expect(res.getBody()).to.not.have.property('groupMatchPresences');
    expect(res.getBody()).to.not.have.property('matchTeams');
  });
}

docs {
  Só traz o registro do match. Presenças (com quem confirmou, recusou ou
  ainda não respondeu) e times ficaram nos domínios deles — ver
  "Find all presences" em 7-match-presences e "Find all match teams" em
  8-match-teams. Antes existia um findOneMatchDetailed que juntava os 3,
  foi quebrado de propósito pra cada domínio expor só o que é dele.
}
