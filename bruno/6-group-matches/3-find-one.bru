meta {
  name: Find one match
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/groups/{{groupId}}/group-matches/{{matchId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("deve retornar a partida com presenças e times", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("matchId"));
    expect(res.getBody()).to.have.property('groupMatchPresences');
    expect(res.getBody()).to.have.property('matchTeams');
    expect(res.getBody().groupMatchPresences).to.be.an('array');
    expect(res.getBody().matchTeams).to.be.an('array');
  });
}

docs {
  Traz a partida com groupMatchPresences e matchTeams (com os jogadores
  de cada time) via include do Prisma. Nesta collection eles vêm vazios,
  já que ainda não existe endpoint pra confirmar presença nem montar
  times — só o schema já modela isso.
}
