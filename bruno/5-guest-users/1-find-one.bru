meta {
  name: Find one guest user
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/groups/{{groupId}}/guest-users/{{guestUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("deve retornar os dados do guest criado", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().id).to.equal(bru.getVar("guestUserId"));
    expect(res.getBody().name).to.equal("Convidado Teste");
  });
}

docs {
  Retorna os dados próprios do guest (nome, posição) — o
  GroupMembersController não expõe isso, só o GroupMember cru.
}
