meta {
  name: Replace all match team players
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/groups/{{groupId}}/group-matches/{{matchId}}/match-team-players
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  [
    {
      "matchTeamId": "{{matchTeamId}}",
      "players": [
        { "userId": "{{userId}}" },
        { "userId": "{{userId2}}" }
      ]
    }
  ]
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("deve apagar o roster atual e recriar com os 2 jogadores", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().count).to.equal(2);
  });
}

docs {
  Protegido por GroupOwnerGuard. Body é um array no nível mais alto (um
  item por time) — cada item tem matchTeamId + a lista de players
  (userId ou guestUserId). Aqui só existe um time (criado em
  8-match-teams), então o array tem uma posição só.

  O ParseArrayPipe valida cada item contra MatchTeamRosterDto, incluindo
  o array aninhado `players` via @ValidateNested.
}
