meta {
  name: Add duplicate player (expect conflict)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/groups/{{groupId}}/group-matches/{{matchId}}/match-team-players/{{matchTeamId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  [
    { "userId": "{{userId}}" }
  ]
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("deve recusar, o dono já está num time dessa partida", function() {
    expect(res.getStatus()).to.equal(409);
  });
}

docs {
  Testa a constraint que adicionamos: {{userId}} já foi colocado nesse
  time no "Replace all match team players" — tentar adicionar de novo
  (mesmo em outro POST) tem que ser barrado pelo checkPlayerNotAlreadyInMatch
  antes de bater no banco.
}
