meta {
  name: Signup 2
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/signup
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "membro.test@peladaplus.com",
    "password": "senha123",
    "name": "Membro Teste",
    "position": "DEFENDER"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("deve criar o segundo usuário e retornar o accessToken", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.property('accessToken');
    bru.setVar("authToken2", res.getBody().accessToken);
  });
}

docs {
  Cria um segundo usuário, usado mais pra frente pra testar o fluxo de
  "entrar num grupo" (POST /groups/:groupId/group-members) como alguém
  que não é o dono.

  Mesma observação do "Signup": se já existir, dá 409 — troque o e-mail
  antes de rodar de novo (não tem um "Signin 2" separado nessa collection,
  esse token já é reaproveitado direto).
}
