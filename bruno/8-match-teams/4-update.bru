meta {
  name: Update match team
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/groups/{{groupId}}/group-matches/{{matchId}}/match-teams/{{matchTeamId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Time Branco Atualizado"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("deve atualizar o nome do time, só o dono pode", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().name).to.equal("Time Branco Atualizado");
  });
}

docs {
  Protegido por GroupOwnerGuard. UpdateMatchTeamDto é PartialType do
  create, então dá pra mandar só o campo que muda (aqui, só o name).
}
