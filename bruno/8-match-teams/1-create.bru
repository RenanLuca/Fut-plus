meta {
  name: Create match team
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/groups/{{groupId}}/group-matches/{{matchId}}/match-teams
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "Time Branco",
    "color": "#FFFFFF"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("deve criar o time, só o dono pode", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.property('id');
    bru.setVar("matchTeamId", res.getBody().id);
  });
}

docs {
  Protegido por GroupOwnerGuard. Precisa rodar depois de "Create match"
  (pasta 6-group-matches) e antes de "Delete match" (também lá).
}
