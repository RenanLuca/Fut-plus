meta {
  name: Find all match teams
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/groups/{{groupId}}/group-matches/{{matchId}}/match-teams
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("deve listar os times da partida com o roster de cada um", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an('array');
    const ids = res.getBody().map((team) => team.id);
    expect(ids).to.include(bru.getVar("matchTeamId"));
    expect(res.getBody()[0]).to.have.property('matchTeamPlayers');
    expect(res.getBody()[0].matchTeamPlayers).to.be.an('array');
  });
}

docs {
  Só exige que o usuário autenticado pertença ao grupo (não precisa ser
  o dono, diferente de create/update). matchTeamPlayers vem incluso
  (esse domínio passou a ser dono do roster, antes só dava pra ver isso
  via o findOneMatchDetailed antigo de group-matches). Aqui ainda vem
  vazio porque roda antes de 9-match-team-players adicionar jogadores.
}
