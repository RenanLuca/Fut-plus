meta {
  name: Find all match teams
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/groups/{{groupId}}/group-matches/{{matchId}}/match-teams
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

vars:pre-request {
  baseUrl: http://localhost:3000
}

tests {
  test("deve listar os times da partida", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an('array');
    const ids = res.getBody().map((team) => team.id);
    expect(ids).to.include(bru.getVar("matchTeamId"));
  });
}

docs {
  Só exige que o usuário autenticado pertença ao grupo (não precisa ser
  o dono, diferente de create/update).
}
