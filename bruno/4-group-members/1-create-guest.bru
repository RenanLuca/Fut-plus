meta {
  name: Add guest member
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/groups/{{groupId}}/group-members
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "type": "GUEST",
    "rank": "BRASILEIRAO",
    "name": "Convidado Teste",
    "position": "DEFENDER"
  }
}

tests {
  test("deve criar o guest e conectar ao grupo", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody()).to.have.property('id');
    bru.setVar("guestUserId", res.getBody().id);
  });
}

docs {
  Quando o type é GUEST, o endpoint cria um GuestUser novo e o conecta
  ao grupo numa transaction (GuestUsersRepository.createAndConnectToGroup).
  name/position só são obrigatórios nesse caso.
}
