meta {
  name: Confirm presence (secondary member)
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/groups/{{groupId}}/group-matches/{{matchId}}/match-presences
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{authToken2}}
}

body:json {
  {
    "isPresent": true
  }
}

tests {
  test("deve confirmar presença do membro secundário", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property('message');
  });
}

docs {
  Confirma presença de um segundo usuário (o dono já testou confirmar e
  depois recusar nos dois requests anteriores, então a presença dele
  ficou isPresent: false). Isso garante que sobra pelo menos um membro
  confirmado pra pasta 8-match-teams testar a geração automática de time.
}
